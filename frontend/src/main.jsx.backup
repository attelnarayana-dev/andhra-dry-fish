function Faq({ question, answer }) {
  const [open, setOpen] = useState(false);

  return (
    <div className={`faq ${open ? "open" : ""}`}>
      <button onClick={() => setOpen((v) => !v)}>
        <span>{question}</span>
        {open ? <X size={20} /> : <Plus size={20} />}
      </button>

      {open && <p>{answer}</p>}
    </div>
  );
}

