@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap');

:root {
  --green: #123f2d;
  --green-dark: #0b2c20;
  --green-light: #eaf3ed;
  --gold: #c9953e;
  --gold-light: #f5ead6;
  --cream: #fbfaf6;
  --white: #ffffff;
  --text: #1d2b24;
  --muted: #6b7771;
  --border: #e4e8e4;
  --shadow: 0 15px 45px rgba(15, 45, 32, 0.09);
  --radius: 16px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: "DM Sans", sans-serif;
  color: var(--text);
  background: var(--cream);
}

button,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

.container {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}

.topbar {
  background: var(--green-dark);
  color: #dfe9e2;
  font-size: 12px;
}

.topbar-inner {
  min-height: 36px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.header {
  background: rgba(255, 255, 255, 0.98);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-inner {
  min-height: 78px;
  display: flex;
  align-items: center;
  gap: 35px;
}

.logo {
  border: 0;
  background: transparent;
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--green);
  padding: 0;
}

.logo-icon {
  width: 43px;
  height: 43px;
  border-radius: 50%;
  background: var(--green-light);
  display: grid;
  place-items: center;
  font-size: 23px;
}

.logo span:last-child {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.logo strong {
  font-family: "Playfair Display", serif;
  font-size: 18px;
  letter-spacing: 1px;
  line-height: 1;
}

.logo small {
  font-size: 9px;
  letter-spacing: 3px;
  margin-top: 4px;
}

.nav {
  display: flex;
  align-items: center;
  gap: 26px;
  flex: 1;
}

.nav button,
.footer-column button {
  border: 0;
  background: transparent;
  color: var(--text);
  padding: 8px 0;
}

.nav button {
  font-weight: 600;
  font-size: 14px;
}

.nav button:hover,
.footer-column button:hover {
  color: var(--gold);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.search-box,
.shop-search {
  border: 1px solid var(--border);
  background: #fff;
  height: 42px;
  border-radius: 9px;
  display: flex;
  align-items: center;
  padding: 0 12px;
  gap: 8px;
}

.search-box {
  width: 220px;
}

.search-box input,
.shop-search input {
  border: 0;
  outline: 0;
  width: 100%;
  background: transparent;
  color: var(--text);
}

.icon-button,
.cart-button,
.mobile-menu {
  border: 0;
  background: transparent;
  color: var(--green);
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
}

.cart-button {
  position: relative;
}

.cart-button span {
  position: absolute;
  top: 2px;
  right: 0;
  width: 19px;
  height: 19px;
  border-radius: 50%;
  background: var(--gold);
  color: white;
  font-size: 10px;
  display: grid;
  place-items: center;
  font-weight: 700;
}

.mobile-menu {
  display: none;
}

.hero {
  min-height: 600px;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 78% 35%, rgba(201, 149, 62, 0.28), transparent 24%),
    linear-gradient(120deg, #0b3021, #164d37 55%, #0b2c20);
  color: white;
}

.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.08;
  background-image: radial-gradient(#fff 1px, transparent 1px);
  background-size: 24px 24px;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(6, 28, 20, 0.35),
    transparent 70%
  );
}

.hero-content {
  min-height: 600px;
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  align-items: center;
  gap: 40px;
}

.hero-copy {
  max-width: 650px;
}

.eyebrow {
  color: var(--gold);
  font-size: 12px;
  letter-spacing: 2.2px;
  font-weight: 700;
}

.hero h1 {
  font-family: "Playfair Display", serif;
  font-size: clamp(48px, 6vw, 76px);
  line-height: 1.08;
  margin: 18px 0;
}

.hero h1 span {
  color: #e5bb70;
}

.hero p {
  max-width: 570px;
  color: #d9e5dd;
  line-height: 1.8;
  font-size: 17px;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 30px;
}

.primary-button,
.secondary-button,
.outline-button,
.checkout-button,
.large-add-button,
.buy-now-button,
.add-button,
.whatsapp-button {
  min-height: 46px;
  border-radius: 8px;
  padding: 0 20px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  font-weight: 700;
  border: 1px solid transparent;
  transition: 0.2s ease;
}

.primary-button {
  background: var(--gold);
  color: white;
}

.primary-button:hover {
  transform: translateY(-2px);
  filter: brightness(1.05);
}

.secondary-button {
  border-color: rgba(255, 255, 255, 0.4);
  color: white;
  background: transparent;
}

.secondary-button:hover {
  background: white;
  color: var(--green);
}

.outline-button {
  background: transparent;
  color: var(--green);
  border-color: var(--green);
}

.outline-button:hover {
  background: var(--green);
  color: white;
}

.hero-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  margin-top: 25px;
  font-size: 12px;
  color: #d9e5dd;
}

.hero-trust span {
  display: flex;
  align-items: center;
  gap: 5px;
}

.hero-product {
  position: relative;
  display: grid;
  place-items: center;
  min-height: 440px;
}

.hero-fish-circle {
  width: 360px;
  height: 360px;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(255, 255, 255, 0.15),
    rgba(201, 149, 62, 0.12)
  );
  border: 1px solid rgba(255, 255, 255, 0.16);
  display: grid;
  place-items: center;
  position: relative;
}

.hero-fish {
  font-size: 145px;
  transform: rotate(-8deg);
  filter: drop-shadow(0 25px 20px rgba(0, 0, 0, 0.2));
}

.hero-prawn {
  position: absolute;
  right: 25px;
  bottom: 65px;
  font-size: 80px;
  transform: rotate(-20deg);
}

.hero-badge {
  position: absolute;
  bottom: 25px;
  left: 30px;
  width: 125px;
  height: 125px;
  border-radius: 50%;
  background: var(--gold);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  transform: rotate(-8deg);
  box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
}

.hero-badge strong {
  font-family: "Playfair Display", serif;
  font-size: 27px;
}

.hero-badge span {
  font-size: 10px;
  line-height: 1.3;
}

.features {
  background: white;
  border-bottom: 1px solid var(--border);
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  padding: 25px 0;
}

.feature {
  display: flex;
  align-items: center;
  gap: 14px;
}

.feature-icon {
  min-width: 45px;
  height: 45px;
  border-radius: 12px;
  background: var(--green-light);
  color: var(--green);
  display: grid;
  place-items: center;
  font-size: 22px;
}

.feature h3 {
  margin: 0 0 3px;
  font-size: 14px;
}

.feature p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.4;
}

.section {
  padding: 90px 0;
}

.section-soft {
  background: #f3f6f2;
}

.section-heading {
  text-align: center;
  max-width: 650px;
  margin: 0 auto 45px;
}

.section-heading h2 {
  font-family: "Playfair Display", serif;
  color: var(--green);
  font-size: clamp(32px, 4vw, 45px);
  margin: 10px 0;
}

.section-heading p {
  color: var(--muted);
  line-height: 1.7;
  margin: 0;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.category-card {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: white;
  overflow: hidden;
  padding: 0;
  text-align: left;
  transition: 0.25s ease;
  box-shadow: 0 8px 30px rgba(20, 50, 35, 0.04);
}

.category-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow);
}

.category-image {
  height: 230px;
  background:
    radial-gradient(circle at 30% 30%, #fff, transparent 25%),
    linear-gradient(135deg, #e9f1eb, #d6e4da);
  display: grid;
  place-items: center;
}

.category-image span {
  font-size: 100px;
  filter: drop-shadow(0 20px 15px rgba(20, 50, 35, 0.12));
}

.category-info {
  padding: 22px;
}

.category-info h3 {
  color: var(--green);
  font-family: "Playfair Display", serif;
  font-size: 23px;
  margin: 0 0 7px;
}

.category-info p {
  color: var(--muted);
  font-size: 13px;
  margin: 0 0 17px;
}

.category-link {
  color: var(--gold);
  font-weight: 700;
  font-size: 13px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.product-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
  transition: 0.25s ease;
}

.product-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow);
}

.product-image {
  width: 100%;
  height: 245px;
  border: 0;
  position: relative;
  background:
    radial-gradient(circle at 30% 25%, #fff, transparent 20%),
    linear-gradient(145deg, #eef4ef, #d8e6dc);
  display: grid;
  place-items: center;
  overflow: hidden;
}

.product-emoji {
  font-size: 95px;
  filter: drop-shadow(0 18px 15px rgba(20, 50, 35, 0.14));
  transition: transform 0.25s ease;
}

.product-card:hover .product-emoji {
  transform: scale(1.08) rotate(-3deg);
}

.discount-badge {
  position: absolute;
  top: 13px;
  left: 13px;
  background: var(--gold);
  color: white;
  padding: 5px 9px;
  border-radius: 5px;
  font-size: 11px;
  font-weight: 700;
  z-index: 2;
}

.quick-view {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 11px;
  background: rgba(18, 63, 45, 0.94);
  color: white;
  font-size: 12px;
  font-weight: 700;
  transform: translateY(100%);
  transition: 0.25s ease;
}

.product-card:hover .quick-view {
  transform: translateY(0);
}

.product-info {
  padding: 17px;
}

.product-category {
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 1px;
  font-size: 10px;
  font-weight: 700;
}

.product-name {
  border: 0;
  background: transparent;
  padding: 5px 0 0;
  text-align: left;
  display: block;
  color: var(--green);
  font-family: "Playfair Display", serif;
  font-size: 18px;
  font-weight: 700;
}

.rating {
  margin: 8px 0 12px;
  font-size: 10px;
}

.rating span,
.details-rating span:first-child {
  color: var(--gold);
  letter-spacing: 1px;
}

.rating small {
  color: var(--muted);
  margin-left: 4px;
}

.price-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 13px;
}

.price-row strong {
  font-size: 19px;
  color: var(--green);
}

.price-row del {
  color: #9ba39e;
  font-size: 12px;
}

.price-row > span {
  margin-left: auto;
  color: var(--muted);
  font-size: 11px;
  background: #f3f5f3;
  padding: 4px 6px;
  border-radius: 4px;
}

.add-button {
  width: 100%;
  background: var(--green);
  color: white;
  min-height: 40px;
  padding: 0 12px;
  font-size: 12px;
}

.add-button:hover {
  background: var(--green-dark);
}

.center-button {
  display: flex;
  justify-content: center;
  margin-top: 35px;
}

.story-banner {
  background: var(--green);
  color: white;
  padding: 85px 0;
  overflow: hidden;
}

.story-grid {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: 80px;
  align-items: center;
}

.story-visual {
  display: grid;
  place-items: center;
}

.story-circle {
  width: 330px;
  height: 330px;
  border-radius: 50%;
  background: radial-gradient(circle, #e5c17c, #a8782e);
  color: var(--green-dark);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 30px 60px rgba(0, 0, 0, 0.2);
}

.story-circle span {
  font-size: 60px;
  margin-bottom: 10px;
}

.story-circle strong {
  font-family: "Playfair Display", serif;
  font-size: 35px;
}

.story-circle small {
  letter-spacing: 5px;
  font-size: 11px;
}

.story-content h2 {
  font-family: "Playfair Display", serif;
  font-size: clamp(34px, 4vw, 50px);
  line-height: 1.15;
  margin: 12px 0 20px;
}

.story-content h2 span {
  color: #e3ba6e;
}

.story-content p {
  color: #d5e2da;
  line-height: 1.8;
  max-width: 600px;
}

.story-content .primary-button {
  margin-top: 14px;
}

.why-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.why-card {
  padding: 30px 22px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  text-align: center;
}

.why-card span {
  display: grid;
  place-items: center;
  font-size: 40px;
  margin-bottom: 15px;
}

.why-card h3 {
  color: var(--green);
  font-family: "Playfair Display", serif;
  margin: 0 0 9px;
  font-size: 19px;
}

.why-card p {
  color: var(--muted);
  line-height: 1.6;
  font-size: 13px;
  margin: 0;
}

.faq-section {
  padding: 90px 0;
  background: #f1f5f1;
}

.faq-container {
  max-width: 850px;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.faq {
  background: white;
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
}

.faq button {
  width: 100%;
  border: 0;
  background: white;
  padding: 20px;
  display: flex;
  justify-content: space-between;
  text-align: left;
  color: var(--green);
  font-weight: 700;
}

.faq p {
  color: var(--muted);
  padding: 0 20px 20px;
  margin: 0;
  line-height: 1.7;
  font-size: 14px;
}

.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 45px;
}

.page-header h1 {
  font-family: "Playfair Display", serif;
  color: var(--green);
  font-size: clamp(38px, 5vw, 55px);
  margin: 10px 0 7px;
}

.page-header p {
  margin: 0;
  color: var(--muted);
}

.page-header.simple {
  align-items: flex-start;
}

.page-header.centered {
  display: block;
  text-align: center;
  max-width: 720px;
  margin-left: auto;
  margin-right: auto;
}

.shop-search {
  width: 300px;
  flex-shrink: 0;
}

.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 30px;
}

.category-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.category-filters button {
  border: 1px solid var(--border);
  background: white;
  color: var(--text);
  padding: 10px 17px;
  border-radius: 7px;
  font-weight: 600;
  font-size: 13px;
}

.category-filters button.active {
  background: var(--green);
  color: white;
  border-color: var(--green);
}

.product-count {
  color: var(--muted);
  font-size: 13px;
}

.empty-products {
  grid-column: 1 / -1;
  text-align: center;
  padding: 70px 20px;
  background: white;
  border-radius: 15px;
  border: 1px solid var(--border);
}

.empty-products div {
  font-size: 55px;
}

.empty-products h3 {
  color: var(--green);
}

.empty-products p {
  color: var(--muted);
}

.back-button,
.continue-shopping {
  border: 0;
  background: transparent;
  color: var(--green);
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 0;
  font-weight: 700;
  margin-bottom: 25px;
}

.details-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 70px;
  align-items: start;
}

.details-image {
  min-height: 570px;
  border-radius: 20px;
  background:
    radial-gradient(circle at 30% 20%, #fff, transparent 25%),
    linear-gradient(145deg, #edf4ef, #d5e4da);
  display: grid;
  place-items: center;
  position: relative;
  overflow: hidden;
}

.details-emoji {
  font-size: 190px;
  filter: drop-shadow(0 30px 25px rgba(15, 50, 32, 0.16));
}

.image-label {
  position: absolute;
  bottom: 25px;
  left: 25px;
  right: 25px;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 10px;
  padding: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  color: var(--green);
  justify-content: center;
}

.details-content {
  padding-top: 15px;
}

.details-content h1 {
  font-family: "Playfair Display", serif;
  color: var(--green);
  font-size: clamp(35px, 4vw, 53px);
  line-height: 1.1;
  margin: 10px 0;
}

.details-rating {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--muted);
  font-size: 12px;
  margin: 15px 0;
}

.details-price {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 20px 0;
}

.details-price strong {
  color: var(--green);
  font-size: 34px;
}

.details-price del {
  color: #9ba39e;
}

.save-badge {
  color: #287044;
  background: #e6f3e9;
  padding: 5px 8px;
  border-radius: 5px;
  font-size: 11px;
  font-weight: 700;
}

.details-description {
  color: var(--muted);
  line-height: 1.8;
  font-size: 15px;
}

.detail-divider {
  height: 1px;
  background: var(--border);
  margin: 25px 0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  color: var(--muted);
  font-size: 14px;
}

.detail-row strong {
  color: var(--text);
}

.available {
  color: #268044 !important;
}

.quantity-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20px 0;
  font-weight: 700;
}

.quantity-control {
  display: flex;
  align-items: center;
  border: 1px solid var(--border);
  border-radius: 7px;
  overflow: hidden;
  width: fit-content;
}

.quantity-control button {
  width: 38px;
  height: 38px;
  border: 0;
  background: white;
  color: var(--green);
  display: grid;
  place-items: center;
}

.quantity-control strong {
  width: 38px;
  text-align: center;
}

.large-add-button {
  width: 100%;
  background: var(--green);
  color: white;
  min-height: 54px;
}

.large-add-button.added {
  background: #2d7b4d;
}

.buy-now-button {
  width: 100%;
  margin-top: 9px;
  min-height: 50px;
  background: var(--gold-light);
  color: var(--green);
}

.delivery-info {
  margin-top: 28px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

.delivery-info > div {
  border: 1px solid var(--border);
  background: white;
  border-radius: 9px;
  padding: 13px;
  display: flex;
  align-items: flex-start;
  gap: 9px;
  color: var(--green);
}

.delivery-info span {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.delivery-info small {
  color: var(--muted);
  font-size: 10px;
}

.cart-layout,
.checkout-layout {
  display: grid;
  grid-template-columns: 1.5fr 0.8fr;
  gap: 30px;
  align-items: start;
}

.cart-items {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.cart-item {
  background: white;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 15px;
  display: grid;
  grid-template-columns: 100px 1fr auto;
  gap: 17px;
  align-items: center;
}

.cart-item-image,
.mini-product-image {
  background: #edf4ef;
  display: grid;
  place-items: center;
  border-radius: 9px;
}

.cart-item-image {
  width: 100px;
  height: 100px;
  font-size: 48px;
}

.cart-item-info > span {
  color: var(--gold);
  text-transform: uppercase;
  font-size: 9px;
  font-weight: 700;
}

.cart-item-info h3 {
  margin: 5px 0;
  color: var(--green);
  font-family: "Playfair Display", serif;
  font-size: 19px;
}

.cart-item-info small {
  color: var(--muted);
}

.cart-item-price {
  color: var(--green);
  font-weight: 700;
  margin-top: 10px;
}

.cart-item-actions {
  display: flex;
  align-items: center;
  gap: 18px;
}

.item-total {
  color: var(--green);
  min-width: 70px;
  text-align: right;
}

.remove-button {
  border: 0;
  background: #f6f1eb;
  color: #9a6543;
  width: 34px;
  height: 34px;
  border-radius: 6px;
  display: grid;
  place-items: center;
}

.order-summary,
.checkout-summary {
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 25px;
  position: sticky;
  top: 110px;
}

.order-summary h2,
.checkout-summary h2 {
  font-family: "Playfair Display", serif;
  color: var(--green);
  margin: 0 0 22px;
}

.summary-line {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  color: var(--muted);
  font-size: 14px;
}

.summary-line strong {
  color: var(--text);
}

.summary-total {
  border-top: 1px solid var(--border);
  margin-top: 10px;
  padding-top: 17px;
  display: flex;
  justify-content: space-between;
  color: var(--green);
  font-weight: 700;
}

.summary-total strong {
  font-size: 23px;
}

.shipping-note {
  color: #42805a;
  background: #edf6ef;
  border-radius: 6px;
  padding: 8px;
  font-size: 11px;
  margin: 8px 0;
}

.checkout-button {
  width: 100%;
  background: var(--green);
  color: white;
  margin-top: 20px;
  min-height: 51px;
}

.checkout-button:hover {
  background: var(--green-dark);
}

.checkout-button:disabled {
  opacity: 0.6;
  cursor: wait;
}

.cod-note {
  margin-top: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  color: #38784f;
  font-size: 11px;
}

.empty-page {
  min-height: 550px;
  display: grid;
  place-items: center;
}

.empty-cart {
  text-align: center;
  max-width: 550px;
  margin: auto;
}

.empty-cart-icon {
  width: 100px;
  height: 100px;
  background: var(--green-light);
  border-radius: 50%;
  display: grid;
  place-items: center;
  margin: 0 auto 20px;
  color: var(--green);
}

.empty-cart h1 {
  font-family: "Playfair Display", serif;
  color: var(--green);
  font-size: 40px;
}

.empty-cart p {
  color: var(--muted);
  margin-bottom: 25px;
}

.checkout-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.form-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 28px;
}

.form-card-heading {
  display: flex;
  gap: 13px;
  align-items: center;
  margin-bottom: 25px;
}

.number {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: var(--green);
  color: white;
  display: grid;
  place-items: center;
  font-weight: 700;
}

.form-card-heading h2 {
  margin: 0 0 3px;
  color: var(--green);
  font-family: "Playfair Display", serif;
  font-size: 22px;
}

.form-card-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 17px;
}

.form-grid label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  font-size: 12px;
  font-weight: 700;
  color: var(--text);
}

.form-grid label.full {
  grid-column: 1 / -1;
}

.form-grid input,
.form-grid textarea {
  width: 100%;
  border: 1px solid var(--border);
  background: #fbfcfa;
  border-radius: 7px;
  outline: 0;
  padding: 12px;
  resize: vertical;
}

.form-grid input:focus,
.form-grid textarea:focus {
  border-color: var(--green);
  background: white;
}

.payment-option {
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 17px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.payment-option.selected {
  border-color: var(--green);
  background: #f4f8f4;
}

.payment-radio {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--green);
  color: white;
  display: grid;
  place-items: center;
  font-size: 13px;
}

.payment-option div:nth-child(2) {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.payment-option span {
  color: var(--muted);
  font-size: 11px;
}

.payment-option strong {
  color: var(--green);
}

.cod-label {
  font-weight: 700;
  color: var(--gold) !important;
}

.checkout-error {
  background: #fff0ec;
  color: #a04430;
  border: 1px solid #f0c9bf;
  border-radius: 8px;
  padding: 13px;
  font-size: 13px;
}

.checkout-products {
  display: flex;
  flex-direction: column;
  gap: 13px;
  margin-bottom: 15px;
}

.checkout-product {
  display: grid;
  grid-template-columns: 48px 1fr auto;
  align-items: center;
  gap: 10px;
}

.mini-product-image {
  width: 48px;
  height: 48px;
  font-size: 23px;
}

.checkout-product > div:nth-child(2) {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.checkout-product strong {
  font-size: 12px;
  color: var(--green);
}

.checkout-product span {
  color: var(--muted);
  font-size: 10px;
}

.checkout-product b {
  font-size: 12px;
  color: var(--text);
}

.secure-note {
  text-align: center;
  color: var(--muted);
  font-size: 10px;
  margin-bottom: 0;
}

.success-page {
  min-height: 650px;
}

.success-card {
  max-width: 760px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 60px 50px;
  margin: auto;
  text-align: center;
  box-shadow: var(--shadow);
}

.success-icon {
  width: 88px;
  height: 88px;
  border-radius: 50%;
  background: #e3f1e6;
  color: #2c7b4b;
  display: grid;
  place-items: center;
  margin: 0 auto 20px;
}

.success-card h1 {
  font-family: "Playfair Display", serif;
  color: var(--green);
  font-size: 42px;
  margin: 12px 0;
}

.success-card > p {
  color: var(--muted);
}

.order-number {
  background: var(--green-light);
  border-radius: 10px;
  padding: 18px;
  margin: 25px 0;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.order-number span {
  font-size: 11px;
  color: var(--muted);
}

.order-number strong {
  color: var(--green);
  font-size: 21px;
  letter-spacing: 1px;
}

.success-info {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  text-align: left;
}

.success-info > div {
  border: 1px solid var(--border);
  border-radius: 9px;
  padding: 14px;
  display: flex;
  gap: 10px;
  color: var(--green);
}

.success-info span {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.success-info small {
  color: var(--muted);
  font-size: 10px;
}

.success-buttons {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-top: 25px;
  flex-wrap: wrap;
}

.about-story {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 75px;
  align-items: center;
}

.about-visual {
  min-height: 480px;
  background:
    radial-gradient(circle at 30% 30%, white, transparent 25%),
    linear-gradient(145deg, #e7f0e9, #cedfd2);
  border-radius: 20px;
  position: relative;
  display: grid;
  place-items: center;
  overflow: hidden;
}

.about-fish {
  font-size: 150px;
  transform: rotate(-10deg);
}

.about-prawn {
  position: absolute;
  bottom: 90px;
  right: 60px;
  font-size: 75px;
  transform: rotate(-20deg);
}

.about-visual > span {
  position: absolute;
  bottom: 25px;
  left: 25px;
  right: 25px;
  text-align: center;
  background: white;
  border-radius: 8px;
  padding: 13px;
  color: var(--green);
  font-weight: 700;
}

.about-copy h2 {
  color: var(--green);
  font-family: "Playfair Display", serif;
  font-size: 48px;
  line-height: 1.1;
  margin: 12px 0 20px;
}

.about-copy h2 span {
  color: var(--gold);
}

.about-copy p {
  color: var(--muted);
  line-height: 1.8;
}

.about-values {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 30px;
}

.about-values div {
  background: white;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.about-values strong {
  color: var(--gold);
}

.about-values span {
  font-size: 12px;
  color: var(--green);
  font-weight: 700;
}

.about-features {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 80px;
}

.about-features > div {
  background: white;
  border: 1px solid var(--border);
  border-radius: 13px;
  text-align: center;
  padding: 30px;
}

.about-features span {
  font-size: 40px;
}

.about-features h3 {
  color: var(--green);
  font-family: "Playfair Display", serif;
}

.about-features p {
  color: var(--muted);
  font-size: 13px;
}

.contact-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.contact-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 30px;
}

.contact-icon {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  background: var(--green-light);
  color: var(--green);
  display: grid;
  place-items: center;
}

.contact-card h3 {
  color: var(--green);
  font-family: "Playfair Display", serif;
  font-size: 21px;
  margin-bottom: 7px;
}

.contact-card p {
  color: var(--muted);
  font-size: 13px;
}

.contact-card a,
.contact-card > span {
  color: var(--gold);
  font-weight: 700;
  font-size: 13px;
}

.contact-bottom {
  margin-top: 30px;
  background: var(--green);
  color: white;
  border-radius: 18px;
  padding: 45px;
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 40px;
  align-items: center;
}

.contact-bottom h2 {
  font-family: "Playfair Display", serif;
  font-size: 35px;
  margin: 10px 0;
}

.contact-bottom p {
  color: #d4e1d9;
  max-width: 560px;
  line-height: 1.7;
}

.whatsapp-button {
  margin-top: 10px;
  background: #27824c;
  color: white;
}

.contact-map {
  min-height: 200px;
  border-radius: 14px;
  background:
    radial-gradient(circle at center, rgba(201, 149, 62, 0.25), transparent 45%),
    #0d3525;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.contact-map span {
  font-size: 45px;
}

.contact-map strong {
  font-family: "Playfair Display", serif;
  font-size: 25px;
  margin-top: 10px;
}

.contact-map small {
  color: #d1dfd6;
  margin-top: 5px;
}

.footer {
  background: #0a2419;
  color: #cbd8d0;
}

.footer-main {
  padding: 65px 0 55px;
  display: grid;
  grid-template-columns: 1.5fr 0.7fr 0.8fr 1fr;
  gap: 55px;
}

.footer-logo {
  color: white;
}

.footer-brand p {
  color: #99aaa0;
  line-height: 1.7;
  max-width: 350px;
  font-size: 13px;
  margin: 18px 0;
}

.socials {
  display: flex;
  gap: 8px;
}

.socials a {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 1px solid #315144;
  display: grid;
  place-items: center;
}

.socials a:hover {
  background: var(--gold);
  border-color: var(--gold);
  color: white;
}

.footer-column {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 7px;
}

.footer-column h3 {
  color: white;
  margin: 0 0 10px;
  font-size: 14px;
}

.footer-column button,
.footer-column span {
  color: #9dafA5;
  font-size: 12px;
  display: flex;
  align-items: center;
  gap: 7px;
}

.footer-column button {
  padding: 0;
}

.footer-bottom {
  border-top: 1px solid #213d31;
}

.footer-bottom-inner {
  min-height: 70px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  font-size: 10px;
  color: #82968a;
}

.footer-bottom-inner div {
  display: flex;
  gap: 18px;
}

.footer-bottom button {
  border: 0;
  background: transparent;
  color: #82968a;
  padding: 0;
  font-size: 10px;
}

@media (max-width: 1000px) {
  .header-inner {
    gap: 18px;
  }

  .nav {
    gap: 14px;
  }

  .search-box {
    width: 170px;
  }

  .product-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .features-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .why-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-main {
    grid-template-columns: 1.3fr 1fr 1fr;
  }
}

@media (max-width: 760px) {
  .container {
    width: min(100% - 28px, 600px);
  }

  .topbar-inner {
    justify-content: center;
    min-height: 32px;
    font-size: 10px;
  }

  .topbar-inner span:nth-child(2),
  .topbar-inner span:nth-child(3) {
    display: none;
  }

  .header-inner {
    min-height: 68px;
    justify-content: space-between;
  }

  .mobile-menu {
    display: grid;
    order: -1;
  }

  .nav {
    display: none;
    position: absolute;
    top: 68px;
    left: 0;
    right: 0;
    background: white;
    border-bottom: 1px solid var(--border);
    padding: 15px;
    flex-direction: column;
    align-items: stretch;
    gap: 2px;
    box-shadow: var(--shadow);
  }

  .nav-open {
    display: flex;
  }

  .nav button {
    padding: 13px 10px;
    text-align: left;
  }

  .header-actions {
    gap: 3px;
  }

  .search-box {
    display: none;
  }

  .logo strong {
    font-size: 16px;
  }

  .logo-icon {
    width: 38px;
    height: 38px;
  }

  .hero,
  .hero-content {
    min-height: auto;
  }

  .hero-content {
    grid-template-columns: 1fr;
    padding-top: 65px;
    padding-bottom: 70px;
  }

  .hero h1 {
    font-size: 45px;
  }

  .hero p {
    font-size: 14px;
  }

  .hero-product {
    min-height: 320px;
  }

  .hero-fish-circle {
    width: 270px;
    height: 270px;
  }

  .hero-fish {
    font-size: 110px;
  }

  .hero-prawn {
    font-size: 60px;
    right: 15px;
    bottom: 45px;
  }

  .hero-badge {
    width: 100px;
    height: 100px;
    left: 15%;
    bottom: 0;
  }

  .hero-trust {
    gap: 9px;
    flex-direction: column;
  }

  .features-grid,
  .category-grid,
  .product-grid,
  .why-grid,
  .about-features,
  .contact-grid {
    grid-template-columns: 1fr;
  }

  .feature {
    padding: 5px 0;
  }

  .section {
    padding: 65px 0;
  }

  .category-image {
    height: 200px;
  }

  .product-grid {
    gap: 14px;
  }

  .product-image {
    height: 220px;
  }

  .story-grid,
  .details-grid,
  .about-story,
  .contact-bottom,
  .cart-layout,
  .checkout-layout {
    grid-template-columns: 1fr;
  }

  .story-grid {
    gap: 45px;
  }

  .story-circle {
    width: 270px;
    height: 270px;
  }

  .story-circle strong {
    font-size: 29px;
  }

  .page-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .page-header.centered {
    align-items: center;
  }

  .shop-search {
    width: 100%;
  }

  .filter-bar {
    align-items: flex-start;
    flex-direction: column;
  }

  .details-grid {
    gap: 30px;
  }

  .details-image {
    min-height: 380px;
  }

  .details-emoji {
    font-size: 130px;
  }

  .delivery-info,
  .success-info {
    grid-template-columns: 1fr;
  }

  .cart-item {
    grid-template-columns: 75px 1fr;
  }

  .cart-item-image {
    width: 75px;
    height: 75px;
  }

  .cart-item-actions {
    grid-column: 1 / -1;
    justify-content: space-between;
  }

  .order-summary,
  .checkout-summary {
    position: static;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .form-grid label.full {
    grid-column: auto;
  }

  .success-card {
    padding: 45px 20px;
  }

  .success-card h1 {
    font-size: 32px;
  }

  .about-copy h2 {
    font-size: 40px;
  }

  .about-values {
    grid-template-columns: 1fr;
  }

  .contact-bottom {
    padding: 30px 20px;
  }

  .footer-main {
    grid-template-columns: 1fr 1fr;
    gap: 35px 25px;
  }

  .footer-brand {
    grid-column: 1 / -1;
  }

  .footer-bottom-inner {
    flex-direction: column;
    justify-content: center;
    padding: 18px 0;
  }

  .footer-bottom-inner div {
    flex-wrap: wrap;
    justify-content: center;
  }
}

@media (max-width: 420px) {
  .hero h1 {
    font-size: 38px;
  }

  .hero-buttons {
    flex-direction: column;
  }

  .hero-buttons button {
    width: 100%;
  }

  .product-grid {
    grid-template-columns: 1fr;
  }

  .product-image {
    height: 250px;
  }

  .success-buttons {
    flex-direction: column;
  }

  .success-buttons button {
    width: 100%;
  }

  .footer-main {
    grid-template-columns: 1fr;
  }

  .footer-brand {
    grid-column: auto;
  }
}
